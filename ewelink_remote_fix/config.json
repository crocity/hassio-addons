{
  "name": "eWeLink-Remote Gateway (Crocity-Fix HA 2026.9)",
  "version": "0.3.1-crocity1",
  "slug": "ewelink_remote_fix",
  "description": "Offizielles Image 0.3.1 + Patch: Bluetooth-Passivscan-Pruefung akzeptiert HA >= 2025.x 'mode: passive' (Upstream-Issue #80). 18.09.2026.",
  "startup": "application",
  "url": "https://github.com/iHost-Open-Source-Project/hassio-ihost-addon/tree/master/hassio-ihost-ewelink-remote",
  "boot": "auto",
  "arch": [
    "amd64"
  ],
  "init": false,
  "panel_icon": "mdi:signal-variant",
  "panel_title": "eWeLink-Remote Gateway",
  "ingress": true,
  "ingress_port": 3031,
  "ingress_stream": true,
  "host_network": true,
  "homeassistant_api": true,
  "hassio_role": "admin",
  "hassio_api": true,
  "host_dbus": true,
  "services": [
    "mqtt:need"
  ],
  "map": [
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/server_data"
    }
  ],
  "options": {
    "log_level": "Info",
    "mqtt": {}
  },
  "schema": {
    "log_level": "list(None|Info|Debug)?",
    "mqtt": {
      "server": "str?",
      "username": "str?",
      "password": "str?"
    }
  },
  "homeassistant": "2025.9.2"
}